# Copy to .env.local. Local values come from `npx supabase status`.
# On Vercel, set these in Project Settings → Environment Variables with the
# remote project's URL and publishable key (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
